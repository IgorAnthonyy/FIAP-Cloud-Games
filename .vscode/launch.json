{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch FCG.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/FCG.Api/bin/Debug/net10.0/FCG.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/FCG.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole"
        }
    ]
}
{
  "info": {
    "_postman_id": "c6218dbe-fc60-4965-8bba-c255ef882672",
    "name": "FIAP Cloud Games",
    "description": "Coleção do Postman mapeando todos os endpoints do sistema FIAP Cloud Games (Autenticação e Gerenciamento de Usuários).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Access",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.token || jsonData.Token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"token\", token);",
                  "    console.log(\"Token de autenticação atualizado automaticamente na variável da coleção.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"SenhaForte123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Access/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "Access",
                "login"
              ]
            },
            "description": "Realiza o login no sistema. O token JWT retornado na resposta é salvo automaticamente na variável da coleção `token`."
          },
          "response": []
        }
      ],
      "description": "Endpoints referentes ao controle de acesso e autenticação."
    },
